# PostgreSQL para producción:
# DATABASE_URL="postgresql://usuario:contraseña@localhost:5432/dulcecuenta?schema=public"

# Clave secreta para firma de sesiones (Auth.js / NextAuth)
AUTH_SECRET="cambiar_por_una_clave_segura_de_al_menos_32_caracteres"
NEXTAUTH_SECRET="cambiar_por_una_clave_segura_de_al_menos_32_caracteres"
